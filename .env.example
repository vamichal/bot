# Скопируйте в .env для локального запуска.
# На Amvera те же ключи задаются в разделе «Переменные окружения».

SECRET_KEY=change-me
BOT_TOKEN=токен-бота-из-MAX
DEBUG=True

# Менеджер в колонтитуле КП — один на все документы.
KP_MANAGER_FIO=Фамилия Имя Отчество
KP_MANAGER_PHONE=8-800-555-38-37

# Чат менеджеров в MAX: туда дублируется каждое собранное КП.
# Это число из ссылки на группу, например https://web.max.ru/-73410621418148
KP_MANAGERS_CHAT_ID=

# Ночная выгрузка оборудования из Access (FTP во внутренней сети).
KP_TMC_FTP_HOST=
KP_TMC_FTP_USER=
KP_TMC_FTP_PASSWORD=
KP_TMC_FTP_DIR=files
KP_TMC_FTP_FILENAME=tmc_data.csv

# Только для прода:
# DATA_DIR=/data
# ALLOWED_HOSTS=myapp.amvera.io
# CSRF_TRUSTED_ORIGINS=https://myapp.amvera.io
